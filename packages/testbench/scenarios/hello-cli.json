  },
  "verification": {
    "type": "script",
    "commands": ["node index.js Alice"],
    "expect_output": "Hello, Alice!",
    "expect_exit_code": 0,
    "timeout_seconds": 30
  },
  "tags": ["trivial", "baseline"]
}
