{
  "name": "ideation-core",
  "version": "0.1.0",
  "description": "Ideation Core - Brainstorming facilitation and nugget crystallization",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
