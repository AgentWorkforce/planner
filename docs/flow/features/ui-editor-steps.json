{
  "feature_id": "ui-editor-steps",
  "title": "Step Editor",
  "type": "feature",
  "status": "approved",
  "priority": "high",
  "dependencies": ["ui-editor-inline"],

  "summary": {
    "goal": "Provide comprehensive editing for step details including acceptance criteria and gates",
    "context": "Steps are the core content of plans. Users need to edit title, description, criteria, owner roles, and gates. Complex edits expand in place rather than opening modals.",
    "acceptance_criteria": [
      { "id": "ac1", "description": "Step card shows title, scope, dependencies count" },
      { "id": "ac2", "description": "Click expands step to show all fields" },
      { "id": "ac3", "description": "Acceptance criteria list with add/edit/remove" },
      { "id": "ac4", "description": "Gate toggle (none / human_approval)" },
      { "id": "ac5", "description": "Owner role selector with common roles" },
      { "id": "ac6", "description": "Dependency display shows what this step depends on" },
      { "id": "ac7", "description": "Delete step with confirmation" },
      { "id": "ac8", "description": "Drag-drop to reorder steps within scope" }
    ]
  },

  "plan_implementation": {
    "scopes": ["planner-ui"],
    "steps": [
      {
        "step_id": "ues001",
        "title": "Create StepCard component",
        "scope": "planner-ui",
        "description": "Collapsed step card showing title, scope badge, dependency count. Expandable.",
        "dependencies": [],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "Card shows step title" },
          { "id": "ac2", "description": "Scope badge displayed" },
          { "id": "ac3", "description": "Dependency count shown" },
          { "id": "ac4", "description": "Click expands to full view" }
        ]
      },
      {
        "step_id": "ues002",
        "title": "Create expanded StepDetail component",
        "scope": "planner-ui",
        "description": "Expanded view with all step fields: title, description, criteria, gate, owner.",
        "dependencies": ["ues001"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "All fields visible when expanded" },
          { "id": "ac2", "description": "Fields use inline editing components" },
          { "id": "ac3", "description": "Collapse button returns to card view" }
        ]
      },
      {
        "step_id": "ues003",
        "title": "Implement acceptance criteria editor",
        "scope": "planner-ui",
        "description": "List of criteria with add, edit inline, remove. Each criterion editable in place.",
        "dependencies": ["ues002"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "List shows all criteria" },
          { "id": "ac2", "description": "Add button appends new criterion" },
          { "id": "ac3", "description": "Click criterion to edit inline" },
          { "id": "ac4", "description": "Remove button deletes criterion" }
        ]
      },
      {
        "step_id": "ues004",
        "title": "Implement gate toggle",
        "scope": "planner-ui",
        "description": "Toggle between no gate and human_approval gate. Optional approver role field.",
        "dependencies": ["ues002"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "Toggle shows gate status" },
          { "id": "ac2", "description": "Enable shows human_approval option" },
          { "id": "ac3", "description": "Approver role field appears when enabled" }
        ]
      },
      {
        "step_id": "ues005",
        "title": "Implement owner role selector",
        "scope": "planner-ui",
        "description": "Dropdown with common roles (backend:Coder, frontend:Coder, etc) plus custom input.",
        "dependencies": ["ues002"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "Dropdown with common roles" },
          { "id": "ac2", "description": "Custom role input option" },
          { "id": "ac3", "description": "Role persisted to step" }
        ]
      },
      {
        "step_id": "ues006",
        "title": "Implement dependency display",
        "scope": "planner-ui",
        "description": "Show which steps this step depends on. Links to those steps.",
        "dependencies": ["ues002"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "List of dependency step titles" },
          { "id": "ac2", "description": "Click navigates to dependency step" },
          { "id": "ac3", "description": "Empty state if no dependencies" }
        ]
      },
      {
        "step_id": "ues007",
        "title": "Implement step deletion",
        "scope": "planner-ui",
        "description": "Delete button with confirmation dialog. Shows warning if step has dependents.",
        "dependencies": ["ues002"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "Delete button visible" },
          { "id": "ac2", "description": "Confirmation dialog before delete" },
          { "id": "ac3", "description": "Warning if other steps depend on this" },
          { "id": "ac4", "description": "Delete removes from plan" }
        ]
      },
      {
        "step_id": "ues008",
        "title": "Implement drag-drop reordering",
        "scope": "planner-ui",
        "description": "Drag steps to reorder within scope. Visual feedback during drag.",
        "dependencies": ["ues001"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "Drag handle on step cards" },
          { "id": "ac2", "description": "Visual feedback during drag" },
          { "id": "ac3", "description": "Drop reorders within scope" },
          { "id": "ac4", "description": "Order persisted to API" }
        ]
      },
      {
        "step_id": "ues009",
        "title": "Add tests for step editor",
        "scope": "planner-ui",
        "description": "Unit tests for all step editor components and interactions.",
        "dependencies": ["ues003", "ues004", "ues005", "ues006", "ues007", "ues008"],
        "owner_role": "frontend:Coder",
        "acceptance_criteria": [
          { "id": "ac1", "description": "StepCard tests pass" },
          { "id": "ac2", "description": "Criteria editor tests pass" },
          { "id": "ac3", "description": "Drag-drop tests pass" }
        ]
      }
    ]
  }
}
