{
  "project_id": "planner",
  "status": "approved",

  "design_system": {
    "feel": "professional, minimal, functional",
    "library": {
      "name": "custom CSS",
      "notes": "No component library - custom React components with CSS variables"
    },
    "colors": {
      "primary": "#2563eb (blue-600)",
      "primary-hover": "#1d4ed8 (blue-700)",
      "secondary": "#64748b (slate-500)",
      "success": "#22c55e (green-500)",
      "error": "#ef4444 (red-500)",
      "warning": "#f59e0b (amber-500)",
      "background": "#ffffff",
      "surface": "#f8fafc (slate-50)",
      "border": "#e2e8f0 (slate-200)",
      "text": "#0f172a (slate-900)",
      "text-muted": "#64748b (slate-500)"
    },
    "spacing": {
      "xs": "0.25rem (4px)",
      "sm": "0.5rem (8px)",
      "md": "1rem (16px)",
      "lg": "1.5rem (24px)",
      "xl": "2rem (32px)"
    },
    "patterns": {
      "cards": "1px border var(--color-border), radius-md, hover border-color change",
      "buttons": "btn class + variant (btn-primary, btn-secondary, btn-danger, btn-success)",
      "badges": "badge class + status variant, uppercase text, small font",
      "collapsible": "expand icon (triangle), body hidden/shown, border highlight when expanded",
      "loading": "spinner animation with border-top color, loading-message text",
      "empty": "centered text with muted color, optional action button",
      "forms": "form-group with label above, full-width inputs, focus border-color change",
      "modals": "modal-overlay (backdrop) + modal (centered card max-w 500px), modal-actions for button row",
      "workflow": "workflow-actions container with workflow-status, workflow-buttons row, workflow-error for inline errors",
      "slide-in-panel": "fixed right-edge (400-420px width), full height, z-index 1000, semi-transparent overlay (rgba 0,0,0,0.3), click-overlay-to-close, Escape-to-close, slideInRight animation. Used by: ChatPanel, CommentThread. Rule: one panel open at a time."
    }
  },

  "components": [
    {
      "id": "planner-core",
      "name": "Planner Core API",
      "tech": ["TypeScript", "Node.js", "SQLite", "Express", "Zod"],
      "path": "src/",
      "description": "Backend service providing REST API, MCP tools, domain model, and storage for plan management"
    },
    {
      "id": "planner-ui",
      "name": "Planner UI",
      "tech": ["TypeScript", "React"],
      "path": "packages/planner-ui/",
      "description": "Frontend application for plan creation, editing, approval workflow, and execution visibility"
    }
  ],

  "features": [
