    { "id": "ui-editor-multiscope", "title": "Multi-Scope Visualization", "type": "feature", "status": "approved", "audit_note": "SwimlaneView integrated - 8/11 criteria met. Missing: collapsible sections, zoom levels, per-scope add button" },
    { "id": "ui-subplan-navigation", "title": "Sub-Plan Navigation", "type": "feature", "status": "approved" },

