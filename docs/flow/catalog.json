    { "id": "ui-dsm-library-selection", "title": "Component Library Selection (Human Gate)", "type": "feature", "status": "completed", "decision": "Adopt Tailwind CSS 4, relay-dashboard CSS vars, dark theme, inline SVG icons. Greenfield - replace all existing planner-ui styles." },
