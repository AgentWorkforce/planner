{
  "project_id": "planner",
  "status": "approved",

  "design_system": {
    "feel": "Mission Control - professional dark theme with neon accents, holographic effects for status-critical items, clean functional areas for editing",
    "library": {
      "name": "shadcn/ui + Tailwind CSS 4",
      "source": "relay-dashboard design system + shadcn/ui components",
      "docs": "https://ui.shadcn.com",
      "notes": "shadcn/ui for complex components (sidebar, dialogs, dropdowns), custom components for domain-specific UI. All themed to Mission Control."
    },
    "typography": {
      "display": "Outfit (400-800)",
      "body": "Inter (400-600)",
      "mono": "IBM Plex Mono (400-600)",
      "scale": "xs:11px, sm:13px, base:14px, lg:15px, xl:16px, 2xl:18px, 3xl:24px, 4xl:32px"
    },
    "colors": {
      "bg-deep": "#0a0a0f",
      "bg-primary": "#0d0d14",
      "bg-secondary": "#12121c",
      "bg-tertiary": "#181824",
      "bg-card": "#1a1a28",
      "bg-elevated": "#202030",
      "text-primary": "#f0f0f5",
      "text-secondary": "#a0a0b0",
      "text-muted": "#606070",
      "accent-cyan": "#00d9ff",
      "accent-orange": "#ff6b35",
      "accent-purple": "#a855f7",
      "accent-green": "#00ffc8",
      "success": "#00ffc8",
      "warning": "#ff6b35",
      "error": "#ff4757",
      "border-default": "rgba(255,255,255,0.1)",
      "border-subtle": "rgba(255,255,255,0.06)"
    },
    "shadows": {
      "glow-cyan": "0 0 20px rgba(0,217,255,0.3)",
      "glow-orange": "0 0 20px rgba(255,107,53,0.3)",
      "glow-green": "0 0 20px rgba(0,255,200,0.3)",
      "modal": "0 16px 70px rgba(0,0,0,0.7)"
    },
    "patterns": {
      "two_row_toolbar": {
        "row1": "breadcrumb + primary action",
        "row2": "filter tabs/pills + status filter + view toggle",
        "layout": {
          "row1": "flex justify-between items-center h-12 px-4 border-b border-border-subtle",
          "row2": "flex justify-between items-center h-12 px-4 gap-4"
        },
        "usage": ["ui-pipeline-view", "ui-plans-view-rework"]
      },
      "cards-clean": "bg-bg-card border-border-subtle rounded-xl, hover:border-border-default transition-colors",
      "cards-holographic": "bg-gradient-to-br from-bg-card to-bg-elevated border-border-subtle rounded-xl, status glow effect",
      "buttons-primary": "bg-accent-cyan text-bg-deep font-medium rounded-lg hover:shadow-glow-cyan transition-all",
      "buttons-secondary": "bg-bg-tertiary text-text-primary border-border-default rounded-lg hover:border-accent-cyan/50",
      "buttons-danger": "bg-error text-white rounded-lg hover:shadow-[0_0_20px_rgba(255,71,87,0.3)]",
      "badges": "inline-flex px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wide",
      "forms": "bg-bg-secondary border-border-default rounded-md focus:border-accent-cyan focus:ring-1 focus:ring-accent-cyan/50",
      "modals": "bg-bg-tertiary border-border-subtle rounded-2xl shadow-modal, overlay bg-black/50",
      "panels": "fixed right-0 w-[420px] h-full bg-bg-secondary border-l border-border-subtle z-40 animate-slide-in-right",
      "focus": "focus-visible:outline-2 focus-visible:outline-accent-cyan focus-visible:outline-offset-2",
      "status-bar": {
        "layout": "fixed bottom-0 left-0 right-0 h-12 bg-bg-secondary border-t border-border-subtle z-50 flex items-center px-4 gap-6",
        "collapsed": "h-6 justify-center gap-2",
        "sections": ["context (shrink-0)", "agents (flex-1 centered)", "stats (shrink-0)", "meta (shrink-0)"],
        "usage": ["ui-status-bar", "ui-agent-orchestration"]
      },
      "agent-avatar": {
        "sizes": { "sm": "w-5 h-5 text-xs", "md": "w-8 h-8 text-base", "lg": "w-10 h-10 text-lg" },
        "states": {
          "working": "green pulsing dot (accent-green)",
          "needs_input": "red ring (error)",
          "idle": "opacity-50",
          "error": "warning icon"
        },
        "usage": ["ui-agent-avatars", "ui-status-bar"]
      },
      "question-type-badges": {
        "blocking": "bg-error/20 text-error text-[10px] px-1.5 py-0.5 rounded uppercase font-medium",
        "preference": "bg-warning/20 text-warning text-[10px] px-1.5 py-0.5 rounded uppercase font-medium",
        "fyi": "bg-accent-cyan/20 text-accent-cyan text-[10px] px-1.5 py-0.5 rounded uppercase font-medium",
        "usage": ["ui-question-queue", "ui-chat-bubbles"]
      },
      "triage-panel": {
        "layout": "fixed right-4 bottom-16 w-80 max-h-[60vh] bg-bg-tertiary border border-border-subtle rounded-xl shadow-modal overflow-hidden z-50",
        "header": "flex items-center justify-between px-3 py-2 bg-bg-secondary border-b border-border-subtle",
        "list": "overflow-y-auto max-h-[45vh] divide-y divide-border-subtle",
        "footer": "flex items-center justify-between px-3 py-2 bg-bg-secondary border-t border-border-subtle",
        "usage": ["ui-question-queue"]
      },
      "step-spec-tabs": {
        "description": "Tabbed interface inside expanded step for spec domains",
        "tabs": ["Details", "Architecture", "Design", "Testing", "Security"],
        "tab_list": "flex gap-1 bg-transparent border-b border-border-subtle px-4",
        "tab_trigger": "px-3 py-2 text-sm text-text-muted hover:text-text-secondary data-[state=active]:text-text-primary data-[state=active]:border-b-2 data-[state=active]:border-accent-cyan",
        "tab_content": "p-4",
        "indicator_dot": "w-1.5 h-1.5 rounded-full bg-accent-cyan ml-1.5",
        "usage": ["schema-ui-specification"]
      },
      "agent-observation-card": {
        "description": "Collapsible card showing agent observations",
        "card": "bg-bg-card border border-border-subtle rounded-lg overflow-hidden",
        "header": "flex items-center justify-between px-4 py-3 bg-bg-tertiary border-b border-border-subtle cursor-pointer hover:bg-bg-secondary/50",
        "body": "p-4 space-y-4",
        "confidence_badges": {
          "exploring": "bg-accent-purple/20 text-accent-purple",
          "forming": "bg-warning/20 text-warning",
          "confident": "bg-success/20 text-success"
        },
        "keyword_chip": "px-2 py-0.5 bg-accent-cyan/10 text-accent-cyan text-xs rounded",
        "usage": ["schema-ui-understanding"]
      }
    },
    "icons": "Inline SVG, stroke-based, strokeWidth=2, currentColor, sizes: 14/16/20/24px"
  },

  "components": [
    {
      "id": "ideation-core",
      "name": "Ideation Core",
      "tech": ["TypeScript", "Node.js", "SQLite", "Express", "Zod", "Relay"],
      "path": "packages/ideation/",
      "description": "Backend service for brainstorming facilitation, session management, and nugget crystallization. Transforms raw intent into refined understanding ready for planning."
    },
    {
      "id": "ideation-ui",
      "name": "Ideation UI",
      "tech": ["TypeScript", "React", "Vite", "Tailwind CSS 4", "shadcn/ui"],
      "path": "packages/ideation-ui/",
      "description": "Frontend application for human-initiated brainstorming sessions with Interviewer agent and real-time specialist observations."
    },
    {
      "id": "planner-core",
      "name": "Planner Core API",
      "tech": ["TypeScript", "Node.js", "SQLite", "Express", "Zod"],
      "path": "src/",
      "description": "Backend service providing REST API, MCP tools, domain model, and storage for plan management"
    },
    {
      "id": "planner-ui",
      "name": "Planner UI",
      "tech": ["TypeScript", "React"],
      "path": "packages/planner-ui/",
      "description": "Frontend application for plan creation, editing, approval workflow, and execution visibility"
    },
    {
      "id": "tuner",
      "name": "Tuner",
      "tech": ["TypeScript", "Node.js", "SQLite", "Express", "Zod"],
      "path": "packages/tuner/",
      "description": "Adaptive learning loop that observes Forge outcomes, builds baselines, detects drift, and learns optimal model selection via Thompson sampling. CLI-only, no UI."
    },
    {
      "id": "forge-core",
      "name": "Forge Core",
      "tech": ["TypeScript", "Node.js", "SQLite", "Express", "Zod"],
      "path": "packages/forge-core/",
      "description": "Orchestration engine for plan execution with budget enforcement, model selection, recovery strategies, and Tuner integration. Executes plans from Planner with observability via Trajectories."
    },
    {
      "id": "testbench",
      "name": "Testbench",
      "tech": ["TypeScript", "Node.js", "commander", "Zod"],
      "path": "packages/testbench/",
      "description": "End-to-end pipeline testing for Planner → Forge → Tuner. Runs predefined scenarios, collects metrics, supports training mode for Tuner learning. CLI-only."
    }
  ],

