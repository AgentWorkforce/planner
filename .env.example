# Anthropic API Key for Claude integration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis connection URL for Cultivate service
# Default: redis://localhost:6379
# The dev.sh script will automatically start Redis if not running
CULTIVATE_REDIS_URL=redis://localhost:6379

# Tuner service URL (optional)
# TUNER_URL=http://localhost:4002

# Optional: Forge execution mode (test or real)
# Defaults to 'test' when relay is disconnected, 'real' when connected
# FORGE_MODE=test
