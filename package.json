{
  "name": "@plannr/monorepo",
  "version": "0.1.0",
  "description": "Plannr monorepo - plan authoring, ideation, and orchestration",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "./scripts/dev.sh start",
    "dev:stop": "./scripts/dev.sh stop",
    "dev:status": "./scripts/dev.sh status",
    "dev:restart": "./scripts/dev.sh restart",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "npm run dev -w planner-ui",
    "test": "vitest run --config vitest.config.ts && npm test -w planner-ui -- --run",
    "test:watch": "vitest --config vitest.config.ts",
    "test:backend": "vitest run --config vitest.config.ts",
    "test:ui": "npm test -w planner-ui -- --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages/*/src/",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@agent-relay/sdk": "^2.0.37",
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@agent-relay/dashboard-server": "^2.0.49",
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.58.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
